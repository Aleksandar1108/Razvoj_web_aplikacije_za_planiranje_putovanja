# Bazni URL Web1 (bez završnog /). Ovde su i /api/v1/auth/* (login, register, me) i admin API.
# Port iz Web1/PackageRoot/ServiceManifest.xml (ServiceEndpoint); prilagodi ako SF dodeli drugačije.
VITE_API_BASE_URL=http://localhost:8915

# Mikroservis planova putovanja (TravelPlansApi/PackageRoot/ServiceManifest.xml — port 8916).
VITE_TRAVEL_PLANS_API_BASE_URL=http://localhost:8916

# Mikroservis destinacija (DestinationsApi/PackageRoot/ServiceManifest.xml — port 8917).
VITE_DESTINATIONS_API_BASE_URL=http://localhost:8917

# Mikroservis aktivnosti po danima (ActivitiesApi/PackageRoot/ServiceManifest.xml — port 8919).
VITE_ACTIVITIES_API_BASE_URL=http://localhost:8919

# Mikroservis troškova i budžeta (ExpensesApi/PackageRoot/ServiceManifest.xml — port 8920).
VITE_EXPENSES_API_BASE_URL=http://localhost:8920

# Mikroservis checklist / packing liste (ChecklistApi/PackageRoot/ServiceManifest.xml — port 8921).
VITE_CHECKLIST_API_BASE_URL=http://localhost:8921

# Mikroservis deljenja planova (SharingApi/PackageRoot/ServiceManifest.xml — port 8922).
VITE_SHARING_API_BASE_URL=http://localhost:8922
