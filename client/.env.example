VITE_TRAVEL_PLANS_API_BASE_URL=http://localhost:8916

# Mikroservis destinacija (DestinationsApi/PackageRoot/ServiceManifest.xml — port 8917).
VITE_DESTINATIONS_API_BASE_URL=http://localhost:8917

# Mikroservis aktivnosti po danima (ActivitiesApi/PackageRoot/ServiceManifest.xml — port 8919).
VITE_ACTIVITIES_API_BASE_URL=http://localhost:8919
